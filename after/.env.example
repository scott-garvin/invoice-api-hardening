# The app connects as a NON-superuser role so Postgres RLS actually applies to it.
# Migrations/seed run as the superuser (which bypasses RLS) — see docker-compose / CI.
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/invoices
# Superuser URL used only for migrate + seed (creates the app_user role, loads schema, seeds cross-org data).
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoices
# Required. The app refuses to boot without it (no hardcoded fallback).
JWT_SECRET=change-me-in-real-life
PORT=3000
